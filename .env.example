# Copy to .env next to compose.yml and fill in. Never commit .env.

# ── Sign-in ──────────────────────────────────────────────────────────────────
# Discord sign-in (https://discord.com/developers/applications → your app → OAuth2).
# Use the same application as Treasure and add this exact Redirect there:
#   https://calendar.niijimasisters.com/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Signs sign-in cookies. Use the SAME value in every Niijima app (openssl rand -hex 32).
SESSION_SECRET=
# Share one sign-in across every *.niijimasisters.com app. Same value in every app.
# Leave empty to keep the sign-in to this app only.
SESSION_DOMAIN=niijimasisters.com
# The address you open the app at, without a trailing slash. compose.yml also passes it to
# the app as ORIGIN: behind the tunnel the app sees plain http, and without it every form
# (saving an event) would be refused by SvelteKit's CSRF check.
PUBLIC_URL=https://calendar.niijimasisters.com
# "discord" (default) or "off". Only use "off" on your own machine.
ACCESS_MODE=discord

# ── Feeds ────────────────────────────────────────────────────────────────────
# Secret part of the .ics address phones subscribe to (/feed/<FEED_TOKEN>.ics).
# Any long random string (openssl rand -hex 24). Empty turns the feed off.
# Changing it breaks existing subscriptions on purpose.
FEED_TOKEN=
# Token Niijima Home sends to /api/upcoming (Authorization: Bearer …).
# Any long random string; the same value goes in Niijima Home. Empty turns the API off.
HOME_TOKEN=

# ── Server setup (used by compose.yml) ───────────────────────────────────────
# Public address Traefik routes to the app.
APP_HOST=calendar.niijimasisters.com
# The Docker network Traefik listens on, and its entrypoint name.
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=web
# User and group the app runs as; they must be able to write ./data (id -u, id -g).
PUID=1000
PGID=1000
